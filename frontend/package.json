{
  "name": "orrery-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/api/generated/openapi.ts",
    "gen:api:check": "openapi-typescript ../api/openapi.yaml -o .gen-api-check.ts >/dev/null && cmp -s .gen-api-check.ts src/api/generated/openapi.ts; s=$?; rm -f .gen-api-check.ts; [ $s -eq 0 ] || echo 'src/api/generated/openapi.ts is stale: run npm run gen:api' >&2; exit $s"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
